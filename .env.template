ENVIRONMENT=production
SECRET_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

REDIS_URL=redis://127.0.0.1:6379/0

# Names match the official pipecat-examples/exotel-chatbot env.example
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_PHONE_NUMBER=
EXOTEL_APP_ID=
EXOTEL_STATUS_CALLBACK_URL=


DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=

# Turn-release controls (not secrets). The default keeps Smart Turn v3 first
# and adds a timeout backstop after VAD stops; speech_timeout is comparison-only.
NXLYR_TURN_MODE=smart_backstop
# Unset or blank defaults to 0.8. Otherwise use a finite decimal from 0.3
# through 2.0 seconds, inclusive. Ignored in speech_timeout mode, which always
# uses its fixed 0.6-second timer.
NXLYR_TURN_BACKSTOP_SECS=0.8

SENTRY_DSN=
POSTHOG_API_KEY=
