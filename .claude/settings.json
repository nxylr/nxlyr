{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git worktree list *)",
      "Bash(ls *)",
      "Bash(npm run build *)",
      "Bash(npm run lint *)",
      "Bash(python -m pytest *)",
      "Bash(python -m unittest *)",
      "Bash(ruff check *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(pip install *)",
      "Bash(docker compose *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./secrets/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * main)",
      "Bash(git push origin main *)",
      "Bash(git merge *)",
      "Bash(gh pr merge *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(psql *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)"
    ]
  }
}
